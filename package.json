{
  "name": "fitbit-google-health-mcp",
  "version": "2.2.1",
  "private": true,
  "description": "Личный MCP-коннектор Google Health (Fitbit / Pixel Watch) для Claude, ChatGPT и Gemini CLI — на бесплатном Cloudflare Workers",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "esbuild src/health-api.ts src/tools.ts --bundle --format=esm --outdir=dist-test --out-extension:.js=.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.119.0"
  }
}
